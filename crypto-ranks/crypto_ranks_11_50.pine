//@version=6
// Original TOP1000 rank snapshot, 2026-09-21. Membership does not rerank automatically.
// Excludes stablecoins, gold-backed tokens, PI/JST/FLR/NEXO/GNO/FF/SUN/GT.
// Shared chart scale: normalized to the host close at the leftmost visible bar.
indicator("Crypto Ranks 11-50 (32)", shorttitle="11-50위 · 32개", overlay=true, max_labels_count=100)
showLabels = input.bool(true, "코인 이름과 등락률 표시")
lineWidth = input.int(1, "선 두께", minval=1, maxval=4)
var float hostBase = na
if time == chart.left_visible_bar_time
    hostBase := close

f_compare(float price, string ticker, color ink) =>
    var float coinBase = na
    var float lastValue = na
    var float lastReturn = na
    var float lastPrice = na
    if time >= chart.left_visible_bar_time and na(coinBase) and not na(price) and price > 0
        coinBase := price
    float change = not na(coinBase) ? (price / coinBase - 1) * 100 : na
    float rebased = not na(hostBase) ? hostBase * (1 + change / 100) : na
    if time <= chart.right_visible_bar_time and not na(rebased)
        lastValue := rebased
        lastReturn := change
        lastPrice := price
    if barstate.islast and showLabels and not na(lastValue)
        label.new(chart.right_visible_bar_time, lastValue, ticker + " " + str.tostring(lastReturn, "#.##") + "%", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(ink, 100), textcolor=ink, size=size.small, tooltip="CRYPTO:" + ticker + " | USD " + str.tostring(lastPrice, "#.########") + " | visible-range change " + str.tostring(lastReturn, "#.##") + "%")
    rebased

// Original rank 11: DOGE
p11 = request.security("CRYPTO:DOGEUSD", timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
v11 = f_compare(p11, "DOGE", #aed322)
plot(v11, title="CRYPTO:DOGEUSD", color=#aed322, linewidth=lineWidth, display=display.pane)

