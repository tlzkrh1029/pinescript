//@version=6
// Original TOP1000 rank snapshot, 2026-09-21. Membership does not rerank automatically.
// Excludes stablecoins, gold-backed tokens, PI/JST/FLR/NEXO/GNO/FF/SUN/GT.
// Shared chart scale: each line starts at the host close of the bar where its base price is taken (the leftmost visible bar).
// A coin whose data starts inside the visible range is based at its first bar instead and marked with "*" and "since <date>".
indicator("Crypto Ranks 101-125 (22)", shorttitle="101-125위 · 22개", overlay=true, max_labels_count=100)
showLabels = input.bool(false, "코인 이름과 등락률 표시")
lineWidth = input.int(1, "선 두께", minval=1, maxval=4)
showBoard = input.bool(true, "등락률 순위표 표시")
boardPos = input.string(position.bottom_right, "순위표 위치", options=[position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right])

// Per-coin readouts collected on the last bar and drawn as one table sorted by return.
var rets = array.new<float>()
var names = array.new<string>()
var inks = array.new<color>()
var tips = array.new<string>()
if barstate.islast
    rets.clear()
    names.clear()
    inks.clear()
    tips.clear()

// Black or white text, whichever has the higher WCAG contrast on the coin colour.
f_linear(float channel) =>
    float s = channel / 255
    s <= 0.04045 ? s / 12.92 : math.pow((s + 0.055) / 1.055, 2.4)

f_textColor(color ink) =>
    0.2126 * f_linear(color.r(ink)) + 0.7152 * f_linear(color.g(ink)) + 0.0722 * f_linear(color.b(ink)) > 0.179 ? color.black : color.white

f_compare(float price, string ticker, string sym, color ink) =>
    var float coinBase = na
    var float hostAnchor = na
    var int baseTime = na
    var int baseDay = na
    var float lastValue = na
    var float lastReturn = na
    var float lastPrice = na
    var label tag = na
    if time >= chart.left_visible_bar_time and na(coinBase) and not na(price) and price > 0
        coinBase := price
        hostAnchor := close
        baseTime := time
        baseDay := time_tradingday
    float change = not na(coinBase) ? (price / coinBase - 1) * 100 : na
    float rebased = not na(hostAnchor) ? hostAnchor * (1 + change / 100) : na
    if time <= chart.right_visible_bar_time and not na(rebased)
        lastValue := rebased
        lastReturn := change
        lastPrice := price
    if barstate.islast
        // Replace the previous bar's label so realtime bars do not leave copies behind.
        label.delete(tag)
        if not na(lastValue)
            bool late = baseTime > chart.left_visible_bar_time
            // Daily bars of overnight sessions open the evening before the date on the axis, so use the trading day there.
            string sinceText = timeframe.isintraday ? str.format_time(baseTime, "yyyy-MM-dd HH:mm z") : timeframe.isdaily and timeframe.multiplier == 1 ? str.format_time(baseDay, "yyyy-MM-dd", "UTC") : str.format_time(baseTime, "yyyy-MM-dd")
            string since = late ? " (since " + sinceText + ")" : ""
            string tip = sym + " | USD " + str.tostring(lastPrice, lastPrice < 0.001 ? "#.############" : "#.########") + " | " + (late ? "change" + since : "visible-range change") + " " + str.tostring(lastReturn, "#.##") + "%"
            if showLabels
                // When scrolled back, the rightmost visible bar touches the price scale, so point the label inward.
                tag := label.new(chart.right_visible_bar_time, lastValue, ticker + " " + str.tostring(lastReturn, "#.##") + "%" + since, xloc=xloc.bar_time, style=chart.right_visible_bar_time < last_bar_time ? label.style_label_right : label.style_label_left, color=ink, textcolor=f_textColor(ink), size=size.small, tooltip=tip)
            rets.push(lastReturn)
            names.push(late ? ticker + "*" : ticker)
            inks.push(ink)
            tips.push(tip)
    rebased

// Original rank 101: TIA
p101 = request.security("CRYPTO:TIA2USD", timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
v101 = f_compare(p101, "TIA", "CRYPTO:TIA2USD", #227fd3)
plot(v101, title="CRYPTO:TIA2USD", color=#227fd3, linewidth=lineWidth, display=display.pane)

// Original rank 102: XTZ
p102 = request.security("CRYPTO:XTZUSD", timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
