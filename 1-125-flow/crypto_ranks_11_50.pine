// Up to 20 rows per column pair; larger groups wrap into a second pair.
var table board = table.new(boardPos, 4, 22, bgcolor=color.new(chart.bg_color, 10))
if barstate.islast
    board.clear(0, 0, 3, 21)
    int n = rets.size()
    if showBoard and n > 0
        // The chart legend is drawn over the top of the pane, so a table placed there starts with a blank row.
        int top = boardPos == position.top_left or boardPos == position.top_center or boardPos == position.top_right ? 1 : 0
        if top == 1
            board.cell(0, 0, " ", text_size=size.normal)
        int perCol = n > 20 ? int(math.ceil(n / 2.0)) : n
        board.cell(0, top, "11-50위", text_color=chart.fg_color, text_size=size.small, text_halign=text.align_left)
        for [k, i] in rets.sort_indices(order.descending)
            int c = k < perCol ? 0 : 2
            int r = top + 1 + k % perCol
            float ret = rets.get(i)
            color ink = inks.get(i)
            board.cell(c, r, names.get(i), bgcolor=ink, text_color=f_textColor(ink), text_size=size.small, text_halign=text.align_left, tooltip=tips.get(i))
            board.cell(c + 1, r, (ret >= 0 ? "+" : "") + str.tostring(ret, "0.00") + "%", text_color=chart.fg_color, text_size=size.small, text_halign=text.align_right, tooltip=tips.get(i))
