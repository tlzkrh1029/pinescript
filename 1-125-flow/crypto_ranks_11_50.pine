v50 = f_compare(p50, "ICP", "CRYPTO:ICPUSD", #d38a22)
plot(v50, title="CRYPTO:ICPUSD", color=#d38a22, linewidth=lineWidth, display=display.pane)

// Up to 20 rows per column group (coin, change vs host since the anchor, last momBars bars vs host); larger groups wrap into a second group.
var table board = table.new(boardPos, 6, 23, bgcolor=color.new(chart.bg_color, 10))
if barstate.islast
    board.clear(0, 0, 5, 22)
    int n = rets.size()
    if n > 0
        array<float> keys = array.new<float>()
        for i = 0 to n - 1
            float key = sortBy == "가속" ? moms.get(i) : vsHost.get(i)
            keys.push(na(key) ? -1e10 : key)
        idx = keys.sort_indices(order.descending)
        if showLabels
            for [k, i] in idx
                if labelCount == 0 or k < labelCount or k >= n - labelCount
                    color ink = inks.get(i)
                    // When scrolled back, the rightmost visible bar touches the price scale, so point the label inward.
                    tags.push(label.new(chart.right_visible_bar_time, ys.get(i), tickers.get(i) + " " + str.tostring(rets.get(i), "#.##") + "%" + sinces.get(i), xloc=xloc.bar_time, style=chart.right_visible_bar_time < last_bar_time ? label.style_label_right : label.style_label_left, color=ink, textcolor=f_textColor(ink), size=size.small, tooltip=tips.get(i)))
        if showBoard
            int beat = 0
            int peers = 0
            for [i, v] in vsHost
                if not selfs.get(i)
                    peers += 1
                    beat += v > 0 ? 1 : 0
            // The chart legend is drawn over the top of the pane, so a table placed there starts with a blank row.
            int top = boardPos == position.top_left or boardPos == position.top_center or boardPos == position.top_right ? 1 : 0
            if top == 1
                board.cell(0, 0, " ", text_size=size.normal)
            int perCol = n > 20 ? int(math.ceil(n / 2.0)) : n
            board.cell(0, top, "11-50위", text_color=chart.fg_color, text_size=boardTextSize, text_halign=text.align_left)
            board.cell(1, top, "강함 " + str.tostring(beat) + "/" + str.tostring(peers), text_color=chart.fg_color, text_size=boardTextSize, text_halign=text.align_right, tooltip="기준 시각 이후 호스트보다 많이 오른 코인 수입니다. 호스트와 같은 코인은 세지 않습니다.")
            board.cell(2, top, "호스트 " + f_pct(na(hostBase) ? na : (hostLast / hostBase - 1) * 100), text_color=chart.fg_color, text_size=boardTextSize, text_halign=text.align_right, tooltip="호스트 차트의 기준 시각 이후 등락률입니다.")
            for g = 0 to (n > 20 ? 1 : 0)
                board.cell(g * 3, top + 1, "코인", text_color=chart.fg_color, text_size=boardTextSize, text_halign=text.align_left)
                board.cell(g * 3 + 1, top + 1, "호스트 대비", text_color=chart.fg_color, text_size=boardTextSize, text_halign=text.align_right)
                board.cell(g * 3 + 2, top + 1, str.tostring(momBars) + "봉", text_color=chart.fg_color, text_size=boardTextSize, text_halign=text.align_right)
            for [k, i] in idx
                int c = k < perCol ? 0 : 3
                int r = top + 2 + k % perCol
                color ink = inks.get(i)
                board.cell(c, r, names.get(i), bgcolor=ink, text_color=f_textColor(ink), text_size=boardTextSize, text_halign=text.align_left, tooltip=tips.get(i))
                board.cell(c + 1, r, f_pct(vsHost.get(i)), text_color=chart.fg_color, text_size=boardTextSize, text_halign=text.align_right, tooltip=tips.get(i))
                board.cell(c + 2, r, f_pct(moms.get(i)), text_color=chart.fg_color, text_size=boardTextSize, text_halign=text.align_right, tooltip=tips.get(i))
