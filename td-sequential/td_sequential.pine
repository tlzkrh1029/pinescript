//@version=6
indicator('TD Sequential (setup 9, countdown 13, TDST)', 'TD Seq', overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=100)

// TD Sequential (Tom DeMark)
// - Setup: 9 consecutive closes below (buy) / above (sell) the close 4 bars earlier, starting on a price flip
//   (the previous bar closed on the other side of its own close 4 bars earlier). A close equal to the close
//   4 bars earlier ends the setup.
// - Perfection: the low of bar 8 or 9 is at or below the lows of bars 6 and 7 (mirrored for sell). If bars 8 and 9
//   miss, a later bar of the same run (before the opposite price flip) whose low reaches that level perfects the setup.
// - TDST: highest true high of a buy setup (resistance) / lowest true low of a sell setup (support).
// - Countdown: starts when a setup completes.
//   Sequential: 13 closes, not necessarily consecutive, at or below the low (buy) / at or above the high (sell)
//   2 bars earlier, counted from setup bar 9. Bar 13 must also trade at or below (buy) / at or above (sell)
//   the close of countdown bar 8. Until it does, the bar is marked '+'. Optionally bar 8 must likewise reach the
//   close of bar 5, and bar 13 can be judged by its open instead of its close (termination count).
//   Aggressive Sequential: the low (buy) / high (sell) is compared with the low / high 2 bars earlier instead of the close.
//   Combo: counted from setup bar 1. A buy countdown bar closes at or below the low 2 bars earlier, has a lower low
//   and a lower close than the previous bar, and closes below the previous countdown bar (mirrored for sell).
//   Optionally bars 11-13 only need to close below (buy) / above (sell) the previous countdown bar.
// - Cancellation: a completed setup in the opposite direction, or a bar beyond the TDST level of the countdown's setup.
// - Recycle (Perl 2008 or DeMARK current), when a later same-direction setup completes during a countdown:
//   if its closes all lie inside the true range of the countdown's setup, the countdown continues; otherwise, if its
//   true range is 100% to 161.8% (Perl) / 100% to 200% (DeMARK) of that setup's, it takes over and the countdown
//   restarts from it; otherwise the countdown continues. When the countdown continues, the later setup's own countdown
//   counts in the background.
//   The size test is repeated on each bar the later setup extends past 9; if it passes, an 'R' marks the bar and the
//   background countdown takes over. A later setup that reaches 18 (Perl) / 22 (DeMARK) bars before an opposite price
//   flip recycles the countdown the same way, and a 13 already printed turns into 'R'.
//   A background countdown also takes over when the drawn one ends. A countdown that completes 13 on a bar is not
//   cancelled or recycled on that bar, except by the length recycle: there the 'R' takes the place of that 13.
// - Risk level: the lowest true low of the setup (9) or of the countdown from bar 1 to 13 minus the true range of that
//   bar (highest true high plus its true range, for sell).

// ---- Inputs
countdownMode = input.string('Sequential', 'Countdown', options=['Sequential', 'Aggressive Sequential', 'Combo'], group='Rules')
comboRelaxed = input.bool(true, 'Combo: bars 11-13 only need to close beyond the previous countdown bar', group='Rules')
recycleVersion = input.string('DeMARK current: 22 bars, 100-200%', 'Recycle rules', options=['DeMARK current: 22 bars, 100-200%', 'Perl 2008: 18 bars, 100-161.8%', 'Always restart'], group='Rules', tooltip='What a later same-direction setup does to a running countdown. The bar count recycles the countdown when a later setup reaches it, and turns a 13 printed since the last opposite price flip into R; the percentage is the size range in which a later setup takes over. A later setup that does not take over counts in the background. Always restart: every new setup restarts the countdown.')
terminationPrice = input.string('Close', 'Price of bar 13 compared 2 bars back (Sequential only)', options=['Close', 'Open'], group='Rules', tooltip='Termination count. DeMark recommends Open, which can complete the 13 earlier. Aggressive Sequential already compares the low (buy) / high (sell).')
use8vs5 = input.bool(false, 'Bar 8 must reach the close of bar 5 (not Combo)', group='Rules')
tdstBasis = input.string('Whole setup', 'TDST level from', options=['Whole setup', 'Setup bar 1'], group='Rules')
tdstCancelMode = input.string('Whole bar beyond TDST', 'Cancel the countdown at TDST', options=['Whole bar beyond TDST', 'Close beyond TDST', 'Off'], group='Rules')
useIntersection = input.bool(false, 'Count only after intersection (not Combo)', group='Rules')

showSetup = input.bool(true, 'Show setup count', group='Display')
setupFrom = input.int(1, 'Show setup count from', minval=1, maxval=9, group='Display')
showCountdown = input.bool(true, 'Show countdown count', group='Display')
showComboSetupBars = input.bool(true, 'Combo: show counts made on setup bars 1-8 (labels)', group='Display')
showTdst = input.bool(true, 'Show TDST lines', group='Display')
showLatePerfection = input.bool(true, 'Mark a setup perfected after bar 9', group='Display')
showRisk = input.bool(true, 'Show the risk level after 13', group='Display')
riskBars = input.int(12, 'Risk level line length after 13 (bars)', minval=1, maxval=100, group='Display')
showSetupRisk = input.bool(false, 'Show the risk level line after 9 (4 bars)', group='Display', tooltip='The tooltip of the 9 always shows the level. The line uses the color of the 9.')
nineSize = input.int(15, 'Size of 9', minval=8, maxval=60, group='Display')
thirteenSize = input.int(18, 'Size of 13', minval=8, maxval=60, group='Display')

buyNineColor = input.color(#089981, 'Buy setup 9', group='Colors')
sellNineColor = input.color(#F23645, 'Sell setup 9', group='Colors')
buyThirteenColor = input.color(#2962FF, 'Buy countdown 13 and risk level', group='Colors')
sellThirteenColor = input.color(#FF9800, 'Sell countdown 13 and risk level', group='Colors')
tdstResistanceColor = input.color(#F23645, 'TDST resistance (buy setup)', group='Colors')
tdstSupportColor = input.color(#089981, 'TDST support (sell setup)', group='Colors')

// The other numbers are plotshape() text, and their colors must be constants: TradingView counts an input or series
// color as one more plot, and 42 plotshape() calls with input colors went over the 64-plot limit (runtime error RE10140).
// Plot counts in use: 44 plotshape() + 4 plot() + 14 alertcondition() = 62 of 64.
buySetupTextColor = #089981
sellSetupTextColor = #F23645
buyCountdownTextColor = #2962FF
sellCountdownTextColor = #FF9800

isCombo = countdownMode == 'Combo'
isAggressive = countdownMode == 'Aggressive Sequential'
recycleOn = recycleVersion != 'Always restart'
isPerl = recycleVersion == 'Perl 2008: 18 bars, 100-161.8%'
recycleCount = isPerl ? 18 : 22
openTermination = terminationPrice == 'Open' and countdownMode == 'Sequential'
qualify8vs5 = use8vs5 and not isCombo
tdstFromBar1 = tdstBasis == 'Setup bar 1'

// ---- Label helpers
// 9, 13, 'R' and any countdown mark on a 9 bar are labels so they can be sized, bold and carry tooltips. TradingView
// keeps only the last 500 labels, which still covers about 10,000 bars because these are rare. Combo counts on setup
// bars 1-8 are labels too, because they are known only when bar 9 completes the setup; only the newest 150 of them are
// kept so they do not push older 9s and 13s out of the 500.
// The other numbers are plotshape() text, which covers the whole history but has a fixed text size.
countLabelAt(x, below, txt, col, sz, tip) =>
    label.new(x, below ? low : high, txt, yloc=below ? yloc.belowbar : yloc.abovebar, style=label.style_none, textcolor=col, size=sz, tooltip=tip)

countLabel(below, txt, col, sz, tip) =>
    countLabelAt(bar_index, below, txt, col, sz, tip)

// Label text is pushed away from the bar with blank lines so it does not cover a number closer to the bar.
paddedText(below, txt, lines) =>
    pad = str.repeat('\n', lines)
    below ? pad + txt : txt + pad

// Setup dates in tooltips, with the time of day (and the UTC offset) on intraday charts.
dateText(t) => str.format_time(t, timeframe.isseconds ? 'yyyy-MM-dd HH:mm:ss Z' : timeframe.isintraday ? 'yyyy-MM-dd HH:mm Z' : 'yyyy-MM-dd', syminfo.timezone)

// TradingView's chart renderer puts style_none label text pt / 0.48 px from the bar (past an invisible shape half as
// tall as the label size, pt / 0.24), adds floor(pt / 6) px of padding, and gives each line pt + round(pt / 6) px.
// plotshape() text has a fixed 12 px font: the setup count next to the bar ends about 32.5 px out and a countdown
// count one line further ends about 46.5 px out.
labelTextStart(pt) => pt / 0.48 + math.floor(pt / 6.0)
labelLineHeight(pt) => pt + math.round(pt / 6.0)
// Blank lines a label of size pt needs so its text starts at least px pixels from the bar.
labelLinesTo(pt, px) => math.max(0, math.ceil((px - labelTextStart(pt)) / labelLineHeight(pt)))

// Countdown labels start just past the setup count next to the bar, or just past the 9 on a 9 bar.
lines13 = labelLinesTo(thirteenSize, 34)
linesSetupBar = labelLinesTo(12, 34)
pastBigNine = labelTextStart(nineSize) + labelLineHeight(nineSize) + 2
linesPastBigNine = labelLinesTo(12, pastBigNine)
lines13PastBigNine = labelLinesTo(thirteenSize, pastBigNine)
// A background 13 on a 9 bar goes past the drawn countdown's count, which is itself past the 9.
lines13PastNineCount = labelLinesTo(thirteenSize, labelTextStart(12) + (linesPastBigNine + 1) * labelLineHeight(12) + 2)
// Past a countdown count, or past a 13, already drawn on the same bar. A 13 from a background countdown goes past the
// drawn countdown's count when both fall on one bar.
linesPastCountdownRow = labelLinesTo(12, 48.5)
lines13PastCountdownRow = labelLinesTo(thirteenSize, 48.5)
pastThirteen = labelTextStart(thirteenSize) + (lines13 + 1) * labelLineHeight(thirteenSize) + 2
linesPastThirteen = labelLinesTo(12, pastThirteen)
lines13PastThirteen = labelLinesTo(thirteenSize, pastThirteen)
lines13PastFarThirteen = labelLinesTo(thirteenSize, labelTextStart(thirteenSize) + (lines13PastCountdownRow + 1) * labelLineHeight(thirteenSize) + 2)
linesPastFarThirteen = labelLinesTo(12, labelTextStart(thirteenSize) + (lines13PastCountdownRow + 1) * labelLineHeight(thirteenSize) + 2)
linesPastThirteenOnNine = labelLinesTo(12, labelTextStart(thirteenSize) + (lines13PastBigNine + 1) * labelLineHeight(thirteenSize) + 2)

// ---- Setup
trueHigh = math.max(high, nz(close[1], high))
trueLow = math.min(low, nz(close[1], low))
trueRange = trueHigh - trueLow
setupHigh = ta.highest(trueHigh, 9)
setupLow = ta.lowest(trueLow, 9)
setupCloseHigh = ta.highest(close, 9)
setupCloseLow = ta.lowest(close, 9)

bearishFlip = close < close[4] and close[1] > close[5]
bullishFlip = close > close[4] and close[1] < close[5]

// Counting continues past 9 while the condition holds, but only 1-9 are labeled.
var int buySetup = 0
var int sellSetup = 0
buySetup := close < close[4] and (buySetup > 0 or bearishFlip) ? buySetup + 1 : 0
sellSetup := close > close[4] and (sellSetup > 0 or bullishFlip) ? sellSetup + 1 : 0

buySetupDone = buySetup == 9
sellSetupDone = sellSetup == 9

// Perfection on bar 9: the low of bar 8 or 9 is at or below the lows of bars 6 and 7 (mirrored for sell).
buyPerfected = math.min(low, low[1]) <= math.min(low[2], low[3])
sellPerfected = math.max(high, high[1]) >= math.max(high[2], high[3])

// A setup that is not perfected on bar 9 is perfected by the first later bar whose low reaches the lows of bars 6 and 7
// (whose high reaches the highs, for sell). Perl expects that retest before the reaction to the setup, so the wait ends
// at the opposite price flip, or when the next setup in either direction completes.
var bool buyPerfectionPending = false
var bool sellPerfectionPending = false
var float buyPerfectionLevel = na
var float sellPerfectionLevel = na
buyLatePerfection = buyPerfectionPending and low <= buyPerfectionLevel
sellLatePerfection = sellPerfectionPending and high >= sellPerfectionLevel
if buyLatePerfection or bullishFlip or buySetupDone or sellSetupDone
    buyPerfectionPending := false
if sellLatePerfection or bearishFlip or buySetupDone or sellSetupDone
    sellPerfectionPending := false
if buySetupDone and not buyPerfected
    buyPerfectionPending := true
    buyPerfectionLevel := math.min(low[2], low[3])
if sellSetupDone and not sellPerfected
    sellPerfectionPending := true
    sellPerfectionLevel := math.max(high[2], high[3])

// Setup risk level (Perl): the lowest true low of the 9 setup bars minus the true range of that bar
// (highest true high plus its true range, for sell).
float buySetupRisk = na
float sellSetupRisk = na
if buySetupDone
    float extreme = na
    for k = 0 to 8
        if na(extreme) or trueLow[k] < extreme
            extreme := trueLow[k]
            buySetupRisk := trueLow[k] - trueRange[k]
if sellSetupDone
    float extreme = na
    for k = 0 to 8
        if na(extreme) or trueHigh[k] > extreme
            extreme := trueHigh[k]
            sellSetupRisk := trueHigh[k] + trueRange[k]

// ---- Countdown conditions
// Computed on every bar so that their history stays consistent; the countdown functions below only read them.
buySeqBar = close <= low[2]
sellSeqBar = close >= high[2]
buyAggBar = low <= low[2]
sellAggBar = high >= high[2]
buyOpenBar = open <= low[2]
sellOpenBar = open >= high[2]
buyComboBar = close <= low[2] and low < low[1] and close < close[1]
sellComboBar = close >= high[2] and high > high[1] and close > close[1]
// Intersection (DeMark 1997): the high of a buy setup bar 8, bar 9 or a later bar reaches the low of a bar 3 or more
// bars earlier, back to setup bar 1 (mirrored for sell). The reference grows by one bar (the bar 3 back) each bar.
lowest5 = ta.lowest(low, 5)
highest5 = ta.highest(high, 5)
low3 = low[3]
high3 = high[3]

// ---- TDST
// Whole setup: the highest true high (buy) / lowest true low (sell) of bars 1-9. Setup bar 1: that bar only.
buyTdstLevel = tdstFromBar1 ? trueHigh[8] : setupHigh
sellTdstLevel = tdstFromBar1 ? trueLow[8] : setupLow

var float tdstResistance = na
var float tdstSupport = na

// Whether the setup closed beyond the TDST level of the latest setup in the opposite direction. A setup that closes
// beyond it shows enough momentum to break that level. One that stays inside it looks like a correction.
buyClosedBelowSupport = not na(tdstSupport) and setupCloseLow < tdstSupport
sellClosedAboveResistance = not na(tdstResistance) and setupCloseHigh > tdstResistance
buyTdstNote = na(tdstSupport) ? '' : buyClosedBelowSupport ? '\nClosed below TDST support ' + str.tostring(tdstSupport, format.mintick) + ': the decline may continue' : '\nStayed above TDST support ' + str.tostring(tdstSupport, format.mintick) + ': a correction that may reverse'
sellTdstNote = na(tdstResistance) ? '' : sellClosedAboveResistance ? '\nClosed above TDST resistance ' + str.tostring(tdstResistance, format.mintick) + ': the advance may continue' : '\nStayed below TDST resistance ' + str.tostring(tdstResistance, format.mintick) + ': a correction that may reverse'

// ---- Countdown state
// Each side has the drawn (active) countdown and the countdowns of later setups that did not take over, which count in
// the background. Perl: a hidden countdown keeps counting and is shown once the first one finishes. When the drawn
// countdown ends, the background countdown closest to 13 takes over (Perl's Bloomberg shows the one closest to
// completion; the older one on a tie). While the drawn one runs it stays drawn even if a background one gets ahead, so
// the drawn numbers never jump; a background 13 is still printed. Every size test compares with the drawn countdown's
// setup.
type Countdown
    bool active = false
    int count = 0
    int start = na
    int startTime = na
    bool runLive = false
    float tdst = na
    line tdstLine = na
    float hi = na
    float lo = na
    float closeHi = na
    float closeLo = na
    float bar5Close = na
    float bar8Close = na
    float lastClose = na
    float riskExtreme = na
    float riskRange = na
    bool intersected = false
    float intersectRef = na
    int countedBar = na
    bool deferredNow = false

// start / startTime: bar 1 of the setup that owns the countdown. runLive: that setup is still extending past bar 9,
// so its true range (hi - lo) and its range of closes (closeHi - closeLo) keep growing. tdst / tdstLine: the level
// that cancels the countdown and the TDST line of its setup. lastClose: Combo, the close of the previous countdown bar.
// riskExtreme / riskRange: lowest true low (buy) / highest true high (sell) since countdown bar 1 and the true range of
// that bar. intersectRef: lowest low (buy) / highest high (sell) from setup bar 1 to 3 bars ago. countedBar /
// deferredNow: the last bar that counted, and whether it was a '+'.

var Countdown buyActive = Countdown.new()
var Countdown sellActive = Countdown.new()
var array<Countdown> buyBackground = array.new<Countdown>()
var array<Countdown> sellBackground = array.new<Countdown>()

// Widen the setup's ranges while the setup keeps extending; Perl compares setups including their bars beyond 9.
extendSetup(Countdown cd, int setupCount) =>
    if cd.runLive
        if setupCount == 0
            cd.runLive := false
        else if setupCount > 9
            cd.hi := math.max(cd.hi, trueHigh)
            cd.lo := math.min(cd.lo, trueLow)
            cd.closeHi := math.max(cd.closeHi, close)
            cd.closeLo := math.min(cd.closeLo, close)
    cd.runLive

// Qualifier I: the later setup's true range is at least the countdown setup's and below 1.618 times it (Perl 2008),
// or at most 2 times it (DeMARK current, 'between 100% and 200%').
sizeRecycles(ratio) => ratio >= 1.0 and (isPerl ? ratio < 1.618 : ratio <= 2.0)

// Qualifier II (setup within a setup) as in Perl's Bloomberg setting 'Extreme Setup Closes Within True Range': the
// later setup's closes all lie inside the countdown setup's true range. It is checked before the size test, and the
// DeMARK version keeps it because the current sources do not mention it.
closesInside(Countdown cd, float closeHi, float closeLo) => closeHi <= cd.hi and closeLo >= cd.lo
sizeRatio(Countdown cd, float hi, float lo) => (cd.hi - cd.lo) > 0 ? (hi - lo) / (cd.hi - cd.lo) : na

tdstBreak(Countdown cd, bool buy) =>
    cd.active and (tdstCancelMode == 'Whole bar beyond TDST' ? (buy ? trueLow > cd.tdst : trueHigh < cd.tdst) : tdstCancelMode == 'Close beyond TDST' ? (buy ? close > cd.tdst : close < cd.tdst) : false)

// One bar of a countdown: whether the bar counts, whether it completes 13, and whether the count waits ('+').
stepCountdown(Countdown cd, bool buy) =>
    bool counted = false
    bool done = false
    bool deferred = false
    if cd.active
        if useIntersection and not isCombo and not cd.intersected
            cd.intersectRef := buy ? math.min(cd.intersectRef, low3) : math.max(cd.intersectRef, high3)
            cd.intersected := buy ? high >= cd.intersectRef : low <= cd.intersectRef
        if isCombo
            beyondLast = na(cd.lastClose) or (buy ? close < cd.lastClose : close > cd.lastClose)
            if comboRelaxed and cd.count >= 10 ? beyondLast : ((buy ? buyComboBar : sellComboBar) and beyondLast)
                counted := true
                cd.count := cd.count + 1
                cd.lastClose := close
                if cd.count == 13
                    done := true
                    cd.active := false
        else
            gate = not useIntersection or cd.intersected
            countBar = gate and (isAggressive ? (buy ? buyAggBar : sellAggBar) : (buy ? buySeqBar : sellSeqBar))
            if cd.count == 12
                lastBar = openTermination ? gate and (buy ? buyOpenBar : sellOpenBar) : countBar
                if lastBar
                    counted := true
                    // Bar 13 has to trade at or below the close of countdown bar 8. Until it does, the bar is marked '+'.
                    if buy ? low <= cd.bar8Close : high >= cd.bar8Close
                        cd.count := 13
                        done := true
                        cd.active := false
                    else
                        deferred := true
            else if countBar
                counted := true
                // Optional 8 vs 5: bar 8 has to trade at or below the close of countdown bar 5, or it waits as '+'.
                if cd.count == 7 and qualify8vs5 and not (buy ? low <= cd.bar5Close : high >= cd.bar5Close)
                    deferred := true
                else
                    cd.count := cd.count + 1
                    if cd.count == 5
                        cd.bar5Close := close
                    else if cd.count == 8
                        cd.bar8Close := close
        // Risk level: the extreme bar of the whole countdown period, from countdown bar 1 to bar 13, counted or not.
        if cd.count > 0 and (na(cd.riskExtreme) or (buy ? trueLow < cd.riskExtreme : trueHigh > cd.riskExtreme))
            cd.riskExtreme := buy ? trueLow : trueHigh
            cd.riskRange := trueRange
        if counted
            cd.countedBar := bar_index
            cd.deferredNow := deferred
    [counted, done, deferred]

// Whether a countdown completes its 13 on this bar, tried on a copy. A completed 13 is never undone (DeMARK: 'Once
// completed, a 9-13 confirmation is permanent'), so such a countdown is not cancelled or size-recycled on its last bar.
completesNow(Countdown cd, bool buy) =>
    bool result = false
    if cd.active and not tdstBreak(cd, buy)
        Countdown probe = cd.copy()
        [_, probeDone, _] = stepCountdown(probe, buy)
        result := probeDone
    result

// Background countdowns. Removed from the list once they end. A size recycle drops them, except one that completes 13 on
// that bar and still prints it; a length recycle drops them all, since their 13 would turn into 'R' on that bar anyway.
extendAll(array<Countdown> cds, int setupCount) =>
    for cd in cds
        extendSetup(cd, setupCount)
    array.size(cds)

cancelAllUnlessCompleting(array<Countdown> cds, bool buy) =>
    for cd in cds
        if not completesNow(cd, buy)
            cd.active := false
    array.size(cds)

// Drops every background countdown that does not complete on this bar; returns how many were dropped.
dropAllUnlessCompleting(array<Countdown> cds, bool buy) =>
    int dropped = 0
    int n = array.size(cds)
    if n > 0
        for j = n - 1 to 0
            Countdown cd = array.get(cds, j)
            if not completesNow(cd, buy)
                if cd.active
                    dropped += 1
                array.remove(cds, j)
    dropped

cancelAllAtTdst(array<Countdown> cds, bool buy) =>
    for cd in cds
        if tdstBreak(cd, buy)
            cd.active := false
    array.size(cds)

// Steps every background countdown. Returns the index of the first that completes 13 on this bar (-1 if none) and the
// latest setup start among those that complete.
stepAll(array<Countdown> cds, bool buy) =>
    int first = -1
    int latestStart = na
    for [j, cd] in cds
        [_, done, _] = stepCountdown(cd, buy)
        if done
            if first < 0
                first := j
            latestStart := na(latestStart) ? cd.start : math.max(latestStart, cd.start)
    [first, latestStart]

pruneEnded(array<Countdown> cds) =>
    int n = array.size(cds)
    if n > 0
        for j = n - 1 to 0
            if not array.get(cds, j).active
                array.remove(cds, j)
    array.size(cds)

// Index of the background countdown closest to 13 (the older one on a tie), or -1.
closestToThirteen(array<Countdown> cds) =>
    int best = -1
    for [j, cd] in cds
        if cd.active and (best < 0 or cd.count > array.get(cds, best).count)
            best := j
    best

// Index of the active background countdown whose setup is still running (at most one), or -1.
runningSetupIndex(array<Countdown> cds) =>
    int result = -1
    for [j, cd] in cds
        if cd.active and cd.runLive
            result := j
    result

// ---- 9-13-9
// A setup whose bar 1 comes after a completed countdown 13 in the same direction, preceded by a price flip
// the other way after that 13 (bullish before a buy setup, bearish before a sell setup),
// with no completed setup in the opposite direction in between.
var int lastBuyThirteenBar = na
var int lastSellThirteenBar = na
var bool buyFlipAfterThirteen = false
var bool sellFlipAfterThirteen = false
if bullishFlip and not na(lastBuyThirteenBar) and bar_index > lastBuyThirteenBar
    buyFlipAfterThirteen := true
if bearishFlip and not na(lastSellThirteenBar) and bar_index > lastSellThirteenBar
    sellFlipAfterThirteen := true
buyNineThirteenNine = buySetupDone and not na(lastBuyThirteenBar) and bar_index - 8 > lastBuyThirteenBar and buyFlipAfterThirteen
sellNineThirteenNine = sellSetupDone and not na(lastSellThirteenBar) and bar_index - 8 > lastSellThirteenBar and sellFlipAfterThirteen

// ---- Countdown
// What the countdown row of each side showed at the end of each bar (0 nothing, 1 a count, '+' or 'x', 2 a 13, 3 a 13
// past a count, 4 a 13 with a count past it). The Combo labels drawn back on setup bars read it so they do not cover
// what an earlier countdown left there.
var int buyRowMark = 0
var int sellRowMark = 0

buyHadCountdown = buyActive.active
sellHadCountdown = sellActive.active
buyCountdownCancelled = false
sellCountdownCancelled = false

extendSetup(buyActive, buySetup)
extendAll(buyBackground, buySetup)
extendSetup(sellActive, sellSetup)
extendAll(sellBackground, sellSetup)

buyActiveCompletes = completesNow(buyActive, true)
sellActiveCompletes = completesNow(sellActive, false)

// A completed setup cancels the countdowns in the opposite direction.
if buySetupDone
    sellCountdownCancelled := sellActive.active and not sellActiveCompletes
    sellActive.active := sellActiveCompletes
    cancelAllUnlessCompleting(sellBackground, false)
if sellSetupDone
    buyCountdownCancelled := buyActive.active and not buyActiveCompletes
    buyActive.active := buyActiveCompletes
    cancelAllUnlessCompleting(buyBackground, true)

// Recycle by length: a later setup that overlaps the countdown reaches 18 / 22 bars before an opposite price flip.
// Its bar 1 is recycleCount - 1 bars back, after bar 1 of the countdown's own setup. Its background countdown takes over
// and every other countdown of an earlier setup is dropped.
laterRunStart = bar_index - recycleCount + 1
buyRecycledByCount = recycleOn and buyActive.active and buySetup == recycleCount and laterRunStart > buyActive.start
sellRecycledByCount = recycleOn and sellActive.active and sellSetup == recycleCount and laterRunStart > sellActive.start
if buyRecycledByCount
    j = runningSetupIndex(buyBackground)
    buyActive := j >= 0 and array.get(buyBackground, j).start == laterRunStart ? array.get(buyBackground, j) : Countdown.new()
    array.clear(buyBackground)
if sellRecycledByCount
    j = runningSetupIndex(sellBackground)
    sellActive := j >= 0 and array.get(sellBackground, j).start == laterRunStart ? array.get(sellBackground, j) : Countdown.new()
    array.clear(sellBackground)

// Recycle by size on a later bar: a background countdown's setup is still extending past 9, so the size test is
// repeated with its grown ranges (Perl: 'a TD Buy Setup can extend beyond TD Setup bar nine').
float buyExtensionRatio = na
float sellExtensionRatio = na
buyRecycledByExtension = false
sellRecycledByExtension = false
buyRunningIndex = runningSetupIndex(buyBackground)
sellRunningIndex = runningSetupIndex(sellBackground)
if recycleOn and buyActive.active and not buyActiveCompletes and buyRunningIndex >= 0 and buySetup > 9
    Countdown later = array.get(buyBackground, buyRunningIndex)
    buyExtensionRatio := sizeRatio(buyActive, later.hi, later.lo)
    buyRecycledByExtension := not closesInside(buyActive, later.closeHi, later.closeLo) and sizeRecycles(buyExtensionRatio)
if recycleOn and sellActive.active and not sellActiveCompletes and sellRunningIndex >= 0 and sellSetup > 9
    Countdown later = array.get(sellBackground, sellRunningIndex)
    sellExtensionRatio := sizeRatio(sellActive, later.hi, later.lo)
    sellRecycledByExtension := not closesInside(sellActive, later.closeHi, later.closeLo) and sizeRecycles(sellExtensionRatio)
if buyRecycledByExtension
    buyActive := array.remove(buyBackground, buyRunningIndex)
    dropAllUnlessCompleting(buyBackground, true)
if sellRecycledByExtension
    sellActive := array.remove(sellBackground, sellRunningIndex)
    dropAllUnlessCompleting(sellBackground, false)
// A later setup's countdown took over on this bar while the setup was running; an 'R' marks it.
buyRecycledLater = buyRecycledByCount or buyRecycledByExtension
sellRecycledLater = sellRecycledByCount or sellRecycledByExtension

// A completed setup starts a countdown in its direction. If one is already running, the recycle rules decide:
// closes all inside the running setup's true range keep the running countdown (Perl's 'setup within a setup'),
// a true range in the size window takes over and restarts the countdown (the background countdowns are dropped), and
// anything else keeps the running countdown while this setup's own countdown counts in the background. A running
// countdown that completes 13 on this bar is left to finish.
buyRestarts = false
sellRestarts = false
buyRecycledBySize = false
sellRecycledBySize = false
float buySizeRatio = na
float sellSizeRatio = na
bool buyInside = false
bool sellInside = false
if buySetupDone
    buyRestarts := not buyActiveCompletes
    if recycleOn and buyActive.active and not buyActiveCompletes
        buySizeRatio := sizeRatio(buyActive, setupHigh, setupLow)
        buyInside := closesInside(buyActive, setupCloseHigh, setupCloseLow)
        buyRestarts := not buyInside and sizeRecycles(buySizeRatio)
        buyRecycledBySize := buyRestarts
if sellSetupDone
    sellRestarts := not sellActiveCompletes
    if recycleOn and sellActive.active and not sellActiveCompletes
        sellSizeRatio := sizeRatio(sellActive, setupHigh, setupLow)
        sellInside := closesInside(sellActive, setupCloseHigh, setupCloseLow)
        sellRestarts := not sellInside and sizeRecycles(sellSizeRatio)
        sellRecycledBySize := sellRestarts

// TDST lines. The latest setup's level is drawn from its bar 1 to the right. If the drawn countdown belongs to an
// earlier setup, that setup's level is the one that cancels it, so its line keeps extending, drawn thicker, until the
// countdown ends. Other lines end when the next setup on their side completes.
var line buyLatestLine = na
var line sellLatestLine = na
var line buyKeptLine = na
var line sellKeptLine = na
var bool buyActiveOwnsLatest = false
var bool sellActiveOwnsLatest = false
var int buyLatestStart = na
var int sellLatestStart = na

endLine(line ln) =>
    if not na(ln)
        line.set_x2(ln, bar_index)
        line.set_extend(ln, extend.none)
    na(ln)

keepLine(line ln) =>
    if not na(ln)
        line.set_extend(ln, extend.right)
        line.set_width(ln, 2)
    ln

if buySetupDone
    tdstResistance := buyTdstLevel
    if showTdst
        if not buyRestarts and buyActive.active and buyActiveOwnsLatest
            buyKeptLine := keepLine(buyLatestLine)
        else
            endLine(buyLatestLine)
        if buyRestarts
            endLine(buyKeptLine)
            buyKeptLine := na
        buyLatestLine := line.new(bar_index - 8, buyTdstLevel, bar_index, buyTdstLevel, extend=extend.right, color=tdstResistanceColor, style=line.style_dashed)
    buyActiveOwnsLatest := buyRestarts
    buyLatestStart := bar_index - 8
if sellSetupDone
    tdstSupport := sellTdstLevel
    if showTdst
        if not sellRestarts and sellActive.active and sellActiveOwnsLatest
            sellKeptLine := keepLine(sellLatestLine)
        else
            endLine(sellLatestLine)
        if sellRestarts
            endLine(sellKeptLine)
            sellKeptLine := na
        sellLatestLine := line.new(bar_index - 8, sellTdstLevel, bar_index, sellTdstLevel, extend=extend.right, color=tdstSupportColor, style=line.style_dashed)
    sellActiveOwnsLatest := sellRestarts
    sellLatestStart := bar_index - 8

// Start the countdown of the setup that completed on this bar, as the active one or in the background.
// Combo counts from setup bar 1, so bars 1-8 are counted now that bar 9 has completed the setup. Their numbers are
// drawn below, once it is known whether this countdown is the drawn one.
var array<int> buyRetro = array.new<int>()
var array<int> sellRetro = array.new<int>()
int buyDropped = 0
int sellDropped = 0
if buySetupDone
    array.clear(buyRetro)
    nc = Countdown.new(active=true, start=bar_index - 8, startTime=time[8], runLive=true, tdst=buyTdstLevel, tdstLine=buyLatestLine, hi=setupHigh, lo=setupLow, closeHi=setupCloseHigh, closeLo=setupCloseLow)
    if useIntersection and not isCombo
        nc.intersectRef := lowest5[4]
        nc.intersected := high[1] >= nc.intersectRef
    if isCombo
        for i = 0 to 7
            k = 8 - i
            if buyComboBar[k] and (na(nc.lastClose) or close[k] < nc.lastClose)
                nc.count := nc.count + 1
                nc.lastClose := close[k]
                array.push(buyRetro, k)
            if nc.count > 0 and (na(nc.riskExtreme) or trueLow[k] < nc.riskExtreme)
                nc.riskExtreme := trueLow[k]
                nc.riskRange := trueRange[k]
    if buyRestarts
        buyActive := nc
        buyDropped := dropAllUnlessCompleting(buyBackground, true)
    else
        array.push(buyBackground, nc)
if sellSetupDone
    array.clear(sellRetro)
    nc = Countdown.new(active=true, start=bar_index - 8, startTime=time[8], runLive=true, tdst=sellTdstLevel, tdstLine=sellLatestLine, hi=setupHigh, lo=setupLow, closeHi=setupCloseHigh, closeLo=setupCloseLow)
    if useIntersection and not isCombo
        nc.intersectRef := highest5[4]
        nc.intersected := low[1] <= nc.intersectRef
    if isCombo
        for i = 0 to 7
            k = 8 - i
            if sellComboBar[k] and (na(nc.lastClose) or close[k] > nc.lastClose)
                nc.count := nc.count + 1
                nc.lastClose := close[k]
                array.push(sellRetro, k)
            if nc.count > 0 and (na(nc.riskExtreme) or trueHigh[k] > nc.riskExtreme)
                nc.riskExtreme := trueHigh[k]
                nc.riskRange := trueRange[k]
    if sellRestarts
        sellActive := nc
        sellDropped := dropAllUnlessCompleting(sellBackground, false)
    else
        array.push(sellBackground, nc)

// Cancel when a bar moves beyond the TDST level of the countdown's own setup.
float buyCancelLevel = na
float sellCancelLevel = na
if tdstBreak(buyActive, true)
    buyCancelLevel := buyActive.tdst
    buyActive.active := false
    buyCountdownCancelled := true
if tdstBreak(sellActive, false)
    sellCancelLevel := sellActive.tdst
    sellActive.active := false
    sellCountdownCancelled := true
cancelAllAtTdst(buyBackground, true)
cancelAllAtTdst(sellBackground, false)

[buyCountdownBar, buyCountdownDone, buyCountdownDeferred] = stepCountdown(buyActive, true)
[sellCountdownBar, sellCountdownDone, sellCountdownDeferred] = stepCountdown(sellActive, false)
[buyBackgroundFirst, buyBackgroundStart] = stepAll(buyBackground, true)
[sellBackgroundFirst, sellBackgroundStart] = stepAll(sellBackground, false)
buyBackgroundDone = buyBackgroundFirst >= 0
sellBackgroundDone = sellBackgroundFirst >= 0

// The drawn countdown as it stands on this bar, before a background countdown can take over below.
buyCount = buyActive.count
sellCount = sellActive.count

// A 13 comes from the drawn countdown, or from a background countdown that completes first. When both complete on one
// bar, a single 13 is drawn; it turns into 'R' only if the later of their setups is recycled.
buyThirteen = buyCountdownDone or buyBackgroundDone
sellThirteen = sellCountdownDone or sellBackgroundDone
buyThirteenFrom = buyCountdownDone or not buyBackgroundDone ? buyActive : array.get(buyBackground, buyBackgroundFirst)
sellThirteenFrom = sellCountdownDone or not sellBackgroundDone ? sellActive : array.get(sellBackground, sellBackgroundFirst)
buyRiskLevel = buyThirteen ? buyThirteenFrom.riskExtreme - buyThirteenFrom.riskRange : na
sellRiskLevel = sellThirteen ? sellThirteenFrom.riskExtreme + sellThirteenFrom.riskRange : na
buyThirteenStart = buyBackgroundDone ? (buyCountdownDone ? math.max(buyActive.start, buyBackgroundStart) : buyBackgroundStart) : buyActive.start
sellThirteenStart = sellBackgroundDone ? (sellCountdownDone ? math.max(sellActive.start, sellBackgroundStart) : sellBackgroundStart) : sellActive.start
string buyThirteenNote = ''
string sellThirteenNote = ''
if buyBackgroundDone
    buyThirteenNote := buyCountdownDone ? '\nThe countdown of the buy setup from ' + dateText(array.get(buyBackground, buyBackgroundFirst).startTime) + ' also completes here' : '\nCounted in the background for the buy setup from ' + dateText(buyThirteenFrom.startTime)
if sellBackgroundDone
    sellThirteenNote := sellCountdownDone ? '\nThe countdown of the sell setup from ' + dateText(array.get(sellBackground, sellBackgroundFirst).startTime) + ' also completes here' : '\nCounted in the background for the sell setup from ' + dateText(sellThirteenFrom.startTime)

// When the drawn countdown ends, the background countdown closest to 13 takes its place.
pruneEnded(buyBackground)
pruneEnded(sellBackground)
buyTakesOver = not buyActive.active and array.size(buyBackground) > 0
sellTakesOver = not sellActive.active and array.size(sellBackground) > 0
if buyTakesOver
    buyActive := array.remove(buyBackground, closestToThirteen(buyBackground))
if sellTakesOver
    sellActive := array.remove(sellBackground, closestToThirteen(sellBackground))
// Data window: 13 on its bar, otherwise the drawn countdown after any takeover.
buyDataCount = buyCountdownDone ? 13 : buyActive.active ? buyActive.count : na
sellDataCount = sellCountdownDone ? 13 : sellActive.active ? sellActive.count : na
string buyContinueNote = ''
string sellContinueNote = ''
if (buyTakesOver or buyRecycledLater) and buyActive.active
    buyContinueNote := '\nThe countdown of the buy setup from ' + dateText(buyActive.startTime) + ' continues at ' + str.tostring(buyActive.count)
if (sellTakesOver or sellRecycledLater) and sellActive.active
    sellContinueNote := '\nThe countdown of the sell setup from ' + dateText(sellActive.startTime) + ' continues at ' + str.tostring(sellActive.count)

// The kept TDST line ends with the countdown it belongs to. A countdown that takes over keeps its own setup's line: the
// latest line, or its earlier line extended again and drawn thicker.
buyNewActive = buyTakesOver or buyRecycledLater
sellNewActive = sellTakesOver or sellRecycledLater
if not na(buyKeptLine) and (not buyActive.active or buyNewActive)
    endLine(buyKeptLine)
    buyKeptLine := na
if not na(sellKeptLine) and (not sellActive.active or sellNewActive)
    endLine(sellKeptLine)
    sellKeptLine := na
if buyNewActive and buyActive.active
    buyActiveOwnsLatest := buyActive.start == buyLatestStart
    if not buyActiveOwnsLatest and showTdst
        buyKeptLine := keepLine(buyActive.tdstLine)
if sellNewActive and sellActive.active
    sellActiveOwnsLatest := sellActive.start == sellLatestStart
    if not sellActiveOwnsLatest and showTdst
        sellKeptLine := keepLine(sellActive.tdstLine)

// Combo numbers on setup bars 1-8, drawn when this setup's countdown is the drawn one: it restarted, or it took over
// right away because the running countdown completed on this bar. They go past what an earlier countdown left there.
retroPad(int rowMark) => rowMark == 4 ? linesPastThirteen + 1 : rowMark == 3 ? linesPastFarThirteen : rowMark == 2 ? linesPastThirteen : rowMark == 1 ? linesPastCountdownRow : linesSetupBar
var array<label> comboLabels = array.new<label>()
if buySetupDone and showCountdown and showComboSetupBars and buyActive.start == bar_index - 8
    for [n, k] in buyRetro
        comboLabel = countLabelAt(bar_index - k, true, paddedText(true, str.tostring(n + 1), retroPad(buyRowMark[k])), buyCountdownTextColor, 12, 'Buy countdown ' + str.tostring(n + 1))
        array.push(comboLabels, comboLabel)
        if array.size(comboLabels) > 150
            label.delete(array.shift(comboLabels))
if sellSetupDone and showCountdown and showComboSetupBars and sellActive.start == bar_index - 8
    for [n, k] in sellRetro
        comboLabel = countLabelAt(bar_index - k, false, paddedText(false, str.tostring(n + 1), retroPad(sellRowMark[k])), sellCountdownTextColor, 12, 'Sell countdown ' + str.tostring(n + 1))
        array.push(comboLabels, comboLabel)
        if array.size(comboLabels) > 150
            label.delete(array.shift(comboLabels))

// ---- Numbers
buyNineShown = showSetup and buySetupDone
sellNineShown = showSetup and sellSetupDone

var label lastBuyNine = na
var label lastSellNine = na
var string lastBuyNineNotes = ''
var string lastSellNineNotes = ''

// A setup perfected after bar 9 gets its 9 redrawn in full color.
if buyLatePerfection and not na(lastBuyNine)
    label.set_textcolor(lastBuyNine, buyNineColor)
    label.set_tooltip(lastBuyNine, 'Buy setup 9 (perfected later)' + lastBuyNineNotes)
if sellLatePerfection and not na(lastSellNine)
    label.set_textcolor(lastSellNine, sellNineColor)
    label.set_tooltip(lastSellNine, 'Sell setup 9 (perfected later)' + lastSellNineNotes)

sizeWindowText = isPerl ? '100-161.8%' : '100-200%'
ratioText(r) => na(r) ? '' : 'size ' + str.tostring(r, '#.###') + 'x the running setup'
cancelText(float level) => tdstCancelMode == 'Off' or na(level) ? '' : '\nThe running countdown is cancelled beyond TDST ' + str.tostring(level, format.mintick)
recycleNote(bool had, bool completes, bool follows, bool restarts, float ratio, bool inside, float level, int dropped) =>
    string note = ''
    if had
        if completes
            note := '\nThe running countdown completes 13 on this bar' + (follows ? ', and the countdown of this setup follows it' : '; this setup counts in the background')
        else if restarts
            note := '\nThe countdown restarts from this setup' + (na(ratio) ? '' : ' (' + ratioText(ratio) + ')') + (dropped > 0 ? '; ' + str.tostring(dropped) + ' background countdown(s) of earlier setups are dropped' : '')
        else
            note := '\nThe running countdown continues (' + (inside ? 'the closes of this setup stay inside its true range, ' : '') + ratioText(ratio) + (inside ? '' : ', outside ' + sizeWindowText) + '); this setup counts in the background' + cancelText(level)
    note
buyRecycleNote = recycleNote(buyHadCountdown, buyActiveCompletes, buyActive.start == bar_index - 8, buyRestarts, buySizeRatio, buyInside, buyActive.tdst, buyDropped)
sellRecycleNote = recycleNote(sellHadCountdown, sellActiveCompletes, sellActive.start == bar_index - 8, sellRestarts, sellSizeRatio, sellInside, sellActive.tdst, sellDropped)

if buyNineShown
    // A setup that is not perfected is drawn faded.
    notes = '\nRisk level ' + str.tostring(buySetupRisk, format.mintick) + buyTdstNote + buyRecycleNote + (buyNineThirteenNine ? '\n9-13-9 after a buy countdown 13' : '')
    buyNine = countLabel(true, '9', buyPerfected ? buyNineColor : color.new(buyNineColor, 50), nineSize, (buyPerfected ? 'Buy setup 9 (perfected)' : 'Buy setup 9 (not perfected)') + notes)
    label.set_text_formatting(buyNine, text.format_bold)
    lastBuyNine := buyNine
    lastBuyNineNotes := notes
if sellNineShown
    notes = '\nRisk level ' + str.tostring(sellSetupRisk, format.mintick) + sellTdstNote + sellRecycleNote + (sellNineThirteenNine ? '\n9-13-9 after a sell countdown 13' : '')
    sellNine = countLabel(false, '9', sellPerfected ? sellNineColor : color.new(sellNineColor, 50), nineSize, (sellPerfected ? 'Sell setup 9 (perfected)' : 'Sell setup 9 (not perfected)') + notes)
    label.set_text_formatting(sellNine, text.format_bold)
    lastSellNine := sellNine
    lastSellNineNotes := notes

// 13s. A 13 on a 9 bar is drawn past the 9, and a background 13 past the drawn countdown's count on the same bar.
thirteenPad(bool nine, bool pastCount) => nine ? (pastCount ? lines13PastNineCount : lines13PastBigNine) : pastCount ? lines13PastCountdownRow : lines13
buyThirteenPastCount = buyCountdownBar and not buyCountdownDone
sellThirteenPastCount = sellCountdownBar and not sellCountdownDone
label buyThirteenLabel = na
label sellThirteenLabel = na
if showCountdown and buyThirteen
    buyThirteenLabel := countLabel(true, paddedText(true, '13', thirteenPad(buyNineShown, buyThirteenPastCount)), buyThirteenColor, thirteenSize, 'Buy countdown 13' + buyThirteenNote + (showRisk ? '\nRisk level ' + str.tostring(buyRiskLevel, format.mintick) : '') + buyContinueNote)
    label.set_text_formatting(buyThirteenLabel, text.format_bold)
if showCountdown and sellThirteen
    sellThirteenLabel := countLabel(false, paddedText(false, '13', thirteenPad(sellNineShown, sellThirteenPastCount)), sellThirteenColor, thirteenSize, 'Sell countdown 13' + sellThirteenNote + (showRisk ? '\nRisk level ' + str.tostring(sellRiskLevel, format.mintick) : '') + sellContinueNote)
    label.set_text_formatting(sellThirteenLabel, text.format_bold)

// The risk level is drawn for the bars after the 13 in which a reversal is expected (4 bars after a 9).
line buyRiskLine = na
line sellRiskLine = na
if showRisk and buyThirteen
    buyRiskLine := line.new(bar_index, buyRiskLevel, bar_index + riskBars, buyRiskLevel, color=buyThirteenColor, style=line.style_dotted)
if showRisk and sellThirteen
    sellRiskLine := line.new(bar_index, sellRiskLevel, bar_index + riskBars, sellRiskLevel, color=sellThirteenColor, style=line.style_dotted)
if showSetupRisk and buyNineShown
    line.new(bar_index, buySetupRisk, bar_index + 4, buySetupRisk, color=buyNineColor, style=line.style_dotted)
if showSetupRisk and sellNineShown
    line.new(bar_index, sellSetupRisk, bar_index + 4, sellSetupRisk, color=sellNineColor, style=line.style_dotted)

// A 13 stays exposed to the length recycle until the opposite price flip (Perl). If a later setup reaches 18 / 22
// bars first, the 13 turns into 'R' and no longer counts for 9-13-9. Perl and DeMARK's TradingView script replace the
// 13 with 'R'; demark.com calls a completed 9-13 permanent, so 'Always restart' never rewrites a 13.
// Every 13 since the last opposite price flip is watched, each with bar 1 of its own setup.
var array<int> buyWatchStarts = array.new<int>()
var array<int> sellWatchStarts = array.new<int>()
var array<int> buyWatchBars = array.new<int>()
var array<int> sellWatchBars = array.new<int>()
var array<label> buyWatchLabels = array.new<label>()
var array<label> sellWatchLabels = array.new<label>()
var array<line> buyWatchRisks = array.new<line>()
var array<line> sellWatchRisks = array.new<line>()
if bullishFlip
    array.clear(buyWatchStarts)
    array.clear(buyWatchBars)
    array.clear(buyWatchLabels)
    array.clear(buyWatchRisks)
if bearishFlip
    array.clear(sellWatchStarts)
    array.clear(sellWatchBars)
    array.clear(sellWatchLabels)
    array.clear(sellWatchRisks)
if buyThirteen
    array.push(buyWatchStarts, buyThirteenStart)
    array.push(buyWatchBars, bar_index)
    array.push(buyWatchLabels, buyThirteenLabel)
    array.push(buyWatchRisks, buyRiskLine)
if sellThirteen
    array.push(sellWatchStarts, sellThirteenStart)
    array.push(sellWatchBars, bar_index)
    array.push(sellWatchLabels, sellThirteenLabel)
    array.push(sellWatchRisks, sellRiskLine)

recycledTip(side, flip) => side + ' countdown 13 recycled (R): a later ' + str.lower(side) + ' setup reached ' + str.tostring(recycleCount) + ' bars before a ' + flip + ' price flip'
// Turns the watched 13s whose setup began before the run that reached 18 / 22 bars into 'R' and removes their risk
// level lines. Returns whether any 13 turned and whether the one printed on this bar did.
recycleThirteens(array<int> starts, array<int> bars, array<label> labels, array<line> risks, int runStart, string tip) =>
    bool any = false
    bool thisBar = false
    int n = array.size(starts)
    if n > 0
        for j = n - 1 to 0
            if runStart > array.get(starts, j)
                lab = array.get(labels, j)
                if not na(lab)
                    label.set_text(lab, str.replace(label.get_text(lab), '13', 'R'))
                    label.set_tooltip(lab, tip)
                line.delete(array.get(risks, j))
                thisBar := thisBar or array.get(bars, j) == bar_index
                any := true
                array.remove(starts, j)
                array.remove(bars, j)
                array.remove(labels, j)
                array.remove(risks, j)
    [any, thisBar]

bool buyThirteenRecycled = false
bool sellThirteenRecycled = false
bool buyThisThirteenRecycled = false
bool sellThisThirteenRecycled = false
if recycleOn and buySetup == recycleCount
    [anyBuy, thisBuy] = recycleThirteens(buyWatchStarts, buyWatchBars, buyWatchLabels, buyWatchRisks, laterRunStart, recycledTip('Buy', 'bullish'))
    buyThirteenRecycled := anyBuy
    buyThisThirteenRecycled := thisBuy
if recycleOn and sellSetup == recycleCount
    [anySell, thisSell] = recycleThirteens(sellWatchStarts, sellWatchBars, sellWatchLabels, sellWatchRisks, laterRunStart, recycledTip('Sell', 'bearish'))
    sellThirteenRecycled := anySell
    sellThisThirteenRecycled := thisSell

// An 'R' marks a running countdown recycled by a later setup on this bar, past what this bar already shows. It is drawn
// like an 'R' that replaced a 13.
laterRecycleTip(side, byCount, ratio) => side + ' countdown recycled (R): a later ' + str.lower(side) + ' setup ' + (byCount ? 'reached ' + str.tostring(recycleCount) + ' bars' : 'grew to ' + ratioText(ratio) + ', inside ' + sizeWindowText)
if showCountdown and buyRecycledLater
    buyR = countLabel(true, paddedText(true, 'R', buyThirteen ? (buyThirteenPastCount ? lines13PastFarThirteen : lines13PastThirteen) : lines13PastCountdownRow), buyThirteenColor, thirteenSize, laterRecycleTip('Buy', buyRecycledByCount, buyExtensionRatio) + buyContinueNote)
    label.set_text_formatting(buyR, text.format_bold)
if showCountdown and sellRecycledLater
    sellR = countLabel(false, paddedText(false, 'R', sellThirteen ? (sellThirteenPastCount ? lines13PastFarThirteen : lines13PastThirteen) : lines13PastCountdownRow), sellThirteenColor, thirteenSize, laterRecycleTip('Sell', sellRecycledByCount, sellExtensionRatio) + sellContinueNote)
    label.set_text_formatting(sellR, text.format_bold)

// A background countdown that takes over after the drawn one completes 13 shows its count past the 13 if it counted on
// this bar. One that takes over after the drawn one is cancelled at TDST gets an 'x' carrying the explanation.
buyTakeoverMark = showCountdown and buyTakesOver and (buyThirteen ? buyActive.countedBar == bar_index : buyCountdownCancelled)
sellTakeoverMark = showCountdown and sellTakesOver and (sellThirteen ? sellActive.countedBar == bar_index : sellCountdownCancelled)
takeoverText(bool thirteen, bool deferred, int count) => thirteen ? (deferred ? '+' : str.tostring(count)) : 'x'
takeoverPad(bool thirteen, bool nine) => thirteen ? (nine ? linesPastThirteenOnNine : linesPastThirteen) : nine ? linesPastBigNine : linesSetupBar
takeoverTip(string side, bool thirteen, float level) => thirteen ? side + ' countdown (taking over after the 13)' : side + ' countdown cancelled at TDST ' + str.tostring(level, format.mintick)
if buyTakeoverMark
    countLabel(true, paddedText(true, takeoverText(buyThirteen, buyActive.deferredNow, buyActive.count), takeoverPad(buyThirteen, buyNineShown)), buyCountdownTextColor, 12, takeoverTip('Buy', buyThirteen, buyCancelLevel) + buyContinueNote)
if sellTakeoverMark
    countLabel(false, paddedText(false, takeoverText(sellThirteen, sellActive.deferredNow, sellActive.count), takeoverPad(sellThirteen, sellNineShown)), sellCountdownTextColor, 12, takeoverTip('Sell', sellThirteen, sellCancelLevel) + sellContinueNote)

// 9-13-9 bookkeeping: the latest 13 that has not turned into 'R'.
if buyNineThirteenNine or sellSetupDone
    lastBuyThirteenBar := na
if sellNineThirteenNine or buySetupDone
    lastSellThirteenBar := na
if buyThirteen and not buyThisThirteenRecycled
    lastBuyThirteenBar := bar_index
    buyFlipAfterThirteen := false
if sellThirteen and not sellThisThirteenRecycled
    lastSellThirteenBar := bar_index
    sellFlipAfterThirteen := false
if buyThirteenRecycled
    lastBuyThirteenBar := array.size(buyWatchBars) > 0 ? array.last(buyWatchBars) : na
if sellThirteenRecycled
    lastSellThirteenBar := array.size(sellWatchBars) > 0 ? array.last(sellWatchBars) : na

// On a 9 bar the countdown mark is a label drawn past the 9.
if showCountdown and buyNineShown and buyCountdownBar and not buyCountdownDone
    buyMarkText = buyCountdownDeferred ? '+' : str.tostring(buyCount)
    countLabel(true, paddedText(true, buyMarkText, linesPastBigNine), buyCountdownTextColor, 12, buyCountdownDeferred ? 'Buy countdown ' + str.tostring(buyCount + 1) + ' deferred (+)' : 'Buy countdown ' + buyMarkText)
if showCountdown and sellNineShown and sellCountdownBar and not sellCountdownDone
    sellMarkText = sellCountdownDeferred ? '+' : str.tostring(sellCount)
    countLabel(false, paddedText(false, sellMarkText, linesPastBigNine), sellCountdownTextColor, 12, sellCountdownDeferred ? 'Sell countdown ' + str.tostring(sellCount + 1) + ' deferred (+)' : 'Sell countdown ' + sellMarkText)

// Setup counts 1-8 sit next to the bar and countdown counts 1-12 and '+' one line further out.
// Below the bar a leading newline is trimmed unless a zero-width space comes first (Pine manual, plotshape() text),
// so the countdown texts below the bar start with an invisible U+200B character.
buySetupMark = showSetup and buySetup >= setupFrom and buySetup < 9 ? buySetup : 0
sellSetupMark = showSetup and sellSetup >= setupFrom and sellSetup < 9 ? sellSetup : 0
// Countdown number drawn on this bar: 1-12, 14 for '+', 0 for none (13 and any mark on a 9 bar are labels).
buyCountdownMark = showCountdown and buyCountdownBar and not buyCountdownDone and not buyNineShown ? (buyCountdownDeferred ? 14 : buyCount) : 0
sellCountdownMark = showCountdown and sellCountdownBar and not sellCountdownDone and not sellNineShown ? (sellCountdownDeferred ? 14 : sellCount) : 0

buyRowMark := showCountdown and buyThirteen ? (buyThirteenPastCount ? 3 : buyTakeoverMark ? 4 : 2) : showCountdown and (buyCountdownBar or buyTakeoverMark) ? 1 : 0
sellRowMark := showCountdown and sellThirteen ? (sellThirteenPastCount ? 3 : sellTakeoverMark ? 4 : 2) : showCountdown and (sellCountdownBar or sellTakeoverMark) ? 1 : 0

plotshape(buySetupMark == 1, 'Buy setup 1', location=location.belowbar, color=na, text='1', textcolor=buySetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 2, 'Buy setup 2', location=location.belowbar, color=na, text='2', textcolor=buySetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 3, 'Buy setup 3', location=location.belowbar, color=na, text='3', textcolor=buySetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 4, 'Buy setup 4', location=location.belowbar, color=na, text='4', textcolor=buySetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 5, 'Buy setup 5', location=location.belowbar, color=na, text='5', textcolor=buySetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 6, 'Buy setup 6', location=location.belowbar, color=na, text='6', textcolor=buySetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 7, 'Buy setup 7', location=location.belowbar, color=na, text='7', textcolor=buySetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 8, 'Buy setup 8', location=location.belowbar, color=na, text='8', textcolor=buySetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 1, 'Sell setup 1', location=location.abovebar, color=na, text='1', textcolor=sellSetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 2, 'Sell setup 2', location=location.abovebar, color=na, text='2', textcolor=sellSetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 3, 'Sell setup 3', location=location.abovebar, color=na, text='3', textcolor=sellSetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 4, 'Sell setup 4', location=location.abovebar, color=na, text='4', textcolor=sellSetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 5, 'Sell setup 5', location=location.abovebar, color=na, text='5', textcolor=sellSetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 6, 'Sell setup 6', location=location.abovebar, color=na, text='6', textcolor=sellSetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 7, 'Sell setup 7', location=location.abovebar, color=na, text='7', textcolor=sellSetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 8, 'Sell setup 8', location=location.abovebar, color=na, text='8', textcolor=sellSetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 1, 'Buy countdown 1', location=location.belowbar, color=na, text='​\n1', textcolor=buyCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 2, 'Buy countdown 2', location=location.belowbar, color=na, text='​\n2', textcolor=buyCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 3, 'Buy countdown 3', location=location.belowbar, color=na, text='​\n3', textcolor=buyCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 4, 'Buy countdown 4', location=location.belowbar, color=na, text='​\n4', textcolor=buyCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 5, 'Buy countdown 5', location=location.belowbar, color=na, text='​\n5', textcolor=buyCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 6, 'Buy countdown 6', location=location.belowbar, color=na, text='​\n6', textcolor=buyCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 7, 'Buy countdown 7', location=location.belowbar, color=na, text='​\n7', textcolor=buyCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 8, 'Buy countdown 8', location=location.belowbar, color=na, text='​\n8', textcolor=buyCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 9, 'Buy countdown 9', location=location.belowbar, color=na, text='​\n9', textcolor=buyCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 10, 'Buy countdown 10', location=location.belowbar, color=na, text='​\n10', textcolor=buyCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 11, 'Buy countdown 11', location=location.belowbar, color=na, text='​\n11', textcolor=buyCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 12, 'Buy countdown 12', location=location.belowbar, color=na, text='​\n12', textcolor=buyCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 14, 'Buy countdown +', location=location.belowbar, color=na, text='​\n+', textcolor=buyCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 1, 'Sell countdown 1', location=location.abovebar, color=na, text='1\n', textcolor=sellCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 2, 'Sell countdown 2', location=location.abovebar, color=na, text='2\n', textcolor=sellCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 3, 'Sell countdown 3', location=location.abovebar, color=na, text='3\n', textcolor=sellCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 4, 'Sell countdown 4', location=location.abovebar, color=na, text='4\n', textcolor=sellCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 5, 'Sell countdown 5', location=location.abovebar, color=na, text='5\n', textcolor=sellCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 6, 'Sell countdown 6', location=location.abovebar, color=na, text='6\n', textcolor=sellCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 7, 'Sell countdown 7', location=location.abovebar, color=na, text='7\n', textcolor=sellCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 8, 'Sell countdown 8', location=location.abovebar, color=na, text='8\n', textcolor=sellCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 9, 'Sell countdown 9', location=location.abovebar, color=na, text='9\n', textcolor=sellCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 10, 'Sell countdown 10', location=location.abovebar, color=na, text='10\n', textcolor=sellCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 11, 'Sell countdown 11', location=location.abovebar, color=na, text='11\n', textcolor=sellCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 12, 'Sell countdown 12', location=location.abovebar, color=na, text='12\n', textcolor=sellCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 14, 'Sell countdown +', location=location.abovebar, color=na, text='+\n', textcolor=sellCountdownTextColor, size=size.tiny, editable=false, display=display.pane)
// A small triangle on the bar that perfects a setup after bar 9.
plotshape(showLatePerfection and buyLatePerfection, 'Buy setup perfected later', style=shape.triangleup, location=location.belowbar, color=buySetupTextColor, size=size.tiny, editable=false, display=display.pane)
plotshape(showLatePerfection and sellLatePerfection, 'Sell setup perfected later', style=shape.triangledown, location=location.abovebar, color=sellSetupTextColor, size=size.tiny, editable=false, display=display.pane)

// ---- Data window and alerts
plot(buySetup > 0 ? buySetup : na, 'Buy setup count', buySetupTextColor, display=display.data_window, precision=0)
plot(sellSetup > 0 ? sellSetup : na, 'Sell setup count', sellSetupTextColor, display=display.data_window, precision=0)
plot(buyDataCount, 'Buy countdown count', buyCountdownTextColor, display=display.data_window, precision=0)
plot(sellDataCount, 'Sell countdown count', sellCountdownTextColor, display=display.data_window, precision=0)

// Alerts fire only on closed bars. On an open bar the close is still moving, so a 9 or a 13 can appear and vanish.
buyRecycled = buyRecycledLater or buyRecycledBySize
sellRecycled = sellRecycledLater or sellRecycledBySize
alertcondition(buySetupDone and barstate.isconfirmed, 'Buy setup 9', 'TD Sequential: buy setup 9 on {{ticker}} ({{interval}})')
alertcondition(sellSetupDone and barstate.isconfirmed, 'Sell setup 9', 'TD Sequential: sell setup 9 on {{ticker}} ({{interval}})')
alertcondition(buyThirteen and barstate.isconfirmed, 'Buy countdown 13', 'TD Sequential: buy countdown 13 on {{ticker}} ({{interval}})')
alertcondition(sellThirteen and barstate.isconfirmed, 'Sell countdown 13', 'TD Sequential: sell countdown 13 on {{ticker}} ({{interval}})')
alertcondition(buyNineThirteenNine and barstate.isconfirmed, 'Buy 9-13-9', 'TD Sequential: buy 9-13-9 on {{ticker}} ({{interval}})')
alertcondition(sellNineThirteenNine and barstate.isconfirmed, 'Sell 9-13-9', 'TD Sequential: sell 9-13-9 on {{ticker}} ({{interval}})')
alertcondition(buyLatePerfection and barstate.isconfirmed, 'Buy setup perfected later', 'TD Sequential: buy setup perfected after bar 9 on {{ticker}} ({{interval}})')
alertcondition(sellLatePerfection and barstate.isconfirmed, 'Sell setup perfected later', 'TD Sequential: sell setup perfected after bar 9 on {{ticker}} ({{interval}})')
alertcondition(buyCountdownCancelled and barstate.isconfirmed, 'Buy countdown cancelled', 'TD Sequential: buy countdown cancelled on {{ticker}} ({{interval}})')
alertcondition(sellCountdownCancelled and barstate.isconfirmed, 'Sell countdown cancelled', 'TD Sequential: sell countdown cancelled on {{ticker}} ({{interval}})')
alertcondition(buyRecycled and barstate.isconfirmed, 'Buy countdown recycled', 'TD Sequential: buy countdown recycled on {{ticker}} ({{interval}})')
alertcondition(sellRecycled and barstate.isconfirmed, 'Sell countdown recycled', 'TD Sequential: sell countdown recycled on {{ticker}} ({{interval}})')
alertcondition(buyThirteenRecycled and barstate.isconfirmed, 'Buy countdown 13 turned into R', 'TD Sequential: a buy countdown 13 turned into R (recycled) on {{ticker}} ({{interval}})')
alertcondition(sellThirteenRecycled and barstate.isconfirmed, 'Sell countdown 13 turned into R', 'TD Sequential: a sell countdown 13 turned into R (recycled) on {{ticker}} ({{interval}})')
