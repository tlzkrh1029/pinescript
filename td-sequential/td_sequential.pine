//@version=6
indicator('TD Sequential (setup 9, countdown 13, TDST)', 'TD Seq', overlay=true, max_labels_count=500, max_lines_count=500)

// TD Sequential (Tom DeMark)
// - Setup: 9 consecutive closes below (buy) / above (sell) the close 4 bars earlier,
//   starting on a price flip (the previous bar closed on the other side of its own close 4 bars earlier).
// - Countdown: starts when a setup completes. 13 closes, not necessarily consecutive,
//   at or below the low (buy) / at or above the high (sell) 2 bars earlier.
//   Bar 13 must also trade at or below (buy) / at or above (sell) the close of countdown bar 8.
// - TDST: highest true high of a buy setup (resistance) / lowest true low of a sell setup (support).

showSetup = input.bool(true, 'Show setup count', group='Display')
setupFrom = input.int(1, 'Show setup count from', minval=1, maxval=9, group='Display')
showCountdown = input.bool(true, 'Show countdown count', group='Display')
showTdst = input.bool(true, 'Show TDST lines', group='Display')
nineSize = input.int(15, 'Size of 9', minval=8, maxval=60, group='Display')
thirteenSize = input.int(18, 'Size of 13', minval=8, maxval=60, group='Display')

buySetupColor = input.color(#089981, 'Buy setup', group='Colors')
sellSetupColor = input.color(#F23645, 'Sell setup', group='Colors')
buyCountdownColor = input.color(#2962FF, 'Buy countdown', group='Colors')
sellCountdownColor = input.color(#FF9800, 'Sell countdown', group='Colors')
tdstResistanceColor = input.color(#F23645, 'TDST resistance (buy setup)', group='Colors')
tdstSupportColor = input.color(#089981, 'TDST support (sell setup)', group='Colors')

// ---- Setup
trueHigh = math.max(high, nz(close[1], high))
trueLow = math.min(low, nz(close[1], low))
setupHigh = ta.highest(trueHigh, 9)
setupLow = ta.lowest(trueLow, 9)

bearishFlip = close < close[4] and close[1] > close[5]
bullishFlip = close > close[4] and close[1] < close[5]

// Counting continues past 9 while the condition holds, but only 1-9 are labeled.
var int buySetup = 0
var int sellSetup = 0
buySetup := close < close[4] and (buySetup > 0 or bearishFlip) ? buySetup + 1 : 0
sellSetup := close > close[4] and (sellSetup > 0 or bullishFlip) ? sellSetup + 1 : 0

buySetupDone = buySetup == 9
sellSetupDone = sellSetup == 9

// Perfection: the low of bar 8 or 9 is at or below the lows of bars 6 and 7 (mirrored for sell).
buyPerfected = math.min(low, low[1]) <= math.min(low[2], low[3])
sellPerfected = math.max(high, high[1]) >= math.max(high[2], high[3])

// ---- TDST
var float tdstResistance = na
var float tdstSupport = na
var line tdstResistanceLine = na
var line tdstSupportLine = na

if buySetupDone
    tdstResistance := setupHigh
    if showTdst
        // End the previous level here and draw the new one from bar 1 of this setup.
        if not na(tdstResistanceLine)
            line.set_x2(tdstResistanceLine, bar_index)
            line.set_extend(tdstResistanceLine, extend.none)
        tdstResistanceLine := line.new(bar_index - 8, tdstResistance, bar_index, tdstResistance, extend=extend.right, color=tdstResistanceColor, style=line.style_dashed)

if sellSetupDone
    tdstSupport := setupLow
    if showTdst
        if not na(tdstSupportLine)
            line.set_x2(tdstSupportLine, bar_index)
            line.set_extend(tdstSupportLine, extend.none)
        tdstSupportLine := line.new(bar_index - 8, tdstSupport, bar_index, tdstSupport, extend=extend.right, color=tdstSupportColor, style=line.style_dashed)

// ---- Countdown
var bool buyCountdownActive = false
var bool sellCountdownActive = false
var int buyCountdown = 0
var int sellCountdown = 0
var float buyBar8Close = na
var float sellBar8Close = na

// A completed setup starts a new countdown in its direction, replacing any unfinished one,
// and cancels the countdown in the opposite direction.
if buySetupDone
    buyCountdownActive := true
    buyCountdown := 0
    buyBar8Close := na
    sellCountdownActive := false

if sellSetupDone
    sellCountdownActive := true
    sellCountdown := 0
    sellBar8Close := na
    buyCountdownActive := false

// Cancel when the whole bar moves beyond the TDST level of the setup that started the countdown.
if buyCountdownActive and trueLow > tdstResistance
    buyCountdownActive := false
if sellCountdownActive and trueHigh < tdstSupport
    sellCountdownActive := false

// The countdown can start on setup bar 9 itself.
buyCountdownBar = buyCountdownActive and close <= low[2]
sellCountdownBar = sellCountdownActive and close >= high[2]
buyCountdownDone = false
sellCountdownDone = false
buyCountdownDeferred = false
sellCountdownDeferred = false

if buyCountdownBar
    if buyCountdown < 12
        buyCountdown += 1
        if buyCountdown == 8
            buyBar8Close := close
    else if low <= buyBar8Close
        buyCountdown := 13
        buyCountdownDone := true
        buyCountdownActive := false
    else
        // Bar 13 has to trade at or below the close of countdown bar 8. Until it does, the bar is marked '+'.
        buyCountdownDeferred := true

if sellCountdownBar
    if sellCountdown < 12
        sellCountdown += 1
        if sellCountdown == 8
            sellBar8Close := close
    else if high >= sellBar8Close
        sellCountdown := 13
        sellCountdownDone := true
        sellCountdownActive := false
    else
        sellCountdownDeferred := true

// ---- Numbers
// 9 and 13 are labels so they can be drawn large and bold. TradingView keeps only the last 500 labels,
// which still covers about 10,000 bars because 9s and 13s are rare.
// The other numbers are plotshape() text, which covers the whole history but has a fixed text size.
countLabel(below, txt, col, sz, tip) =>
    label.new(bar_index, below ? low : high, txt, yloc=below ? yloc.belowbar : yloc.abovebar, style=label.style_none, textcolor=col, size=sz, tooltip=tip)

// Label text is pushed away from the bar with blank lines so it does not cover a number closer to the bar.
paddedText(below, txt, lines) =>
    pad = str.repeat('\n', lines)
    below ? pad + txt : txt + pad

// TradingView's chart renderer puts style_none label text pt / 0.48 px from the bar (past an invisible shape half as
// tall as the label size, pt / 0.24), adds floor(pt / 6) px of padding, and gives each line pt + round(pt / 6) px.
// plotshape() text has a fixed 12 px font, and the setup count next to the bar ends about 32.5 px out.
labelTextStart(pt) => pt / 0.48 + math.floor(pt / 6.0)
labelLineHeight(pt) => pt + math.round(pt / 6.0)
// Blank lines a label of size pt needs so its text starts at least px pixels from the bar.
labelLinesTo(pt, px) => math.max(0, math.ceil((px - labelTextStart(pt)) / labelLineHeight(pt)))

// The 13 starts just past the setup count next to the bar, and a countdown 1 on a 9 bar just past the 9.
lines13 = labelLinesTo(thirteenSize, 34)
linesPastBigNine = labelLinesTo(12, labelTextStart(nineSize) + labelLineHeight(nineSize) + 2)

buyNineShown = showSetup and buySetupDone
sellNineShown = showSetup and sellSetupDone

if buyNineShown
    // A setup that is not perfected is drawn faded.
    buyNine = countLabel(true, '9', buyPerfected ? buySetupColor : color.new(buySetupColor, 50), nineSize, buyPerfected ? 'Buy setup 9 (perfected)' : 'Buy setup 9 (not perfected)')
    label.set_text_formatting(buyNine, text.format_bold)
if sellNineShown
    sellNine = countLabel(false, '9', sellPerfected ? sellSetupColor : color.new(sellSetupColor, 50), nineSize, sellPerfected ? 'Sell setup 9 (perfected)' : 'Sell setup 9 (not perfected)')
    label.set_text_formatting(sellNine, text.format_bold)

if showCountdown and buyCountdownDone
    buyThirteen = countLabel(true, paddedText(true, '13', lines13), buyCountdownColor, thirteenSize, 'Buy countdown 13')
    label.set_text_formatting(buyThirteen, text.format_bold)
if showCountdown and sellCountdownDone
    sellThirteen = countLabel(false, paddedText(false, '13', lines13), sellCountdownColor, thirteenSize, 'Sell countdown 13')
    label.set_text_formatting(sellThirteen, text.format_bold)

// A setup 9 restarts its countdown, so the only countdown number that can share a bar with a 9 is 1.
if showCountdown and buyCountdownBar and buyNineShown
    countLabel(true, paddedText(true, '1', linesPastBigNine), buyCountdownColor, 12, 'Buy countdown 1')
if showCountdown and sellCountdownBar and sellNineShown
    countLabel(false, paddedText(false, '1', linesPastBigNine), sellCountdownColor, 12, 'Sell countdown 1')

// Setup counts 1-8 sit next to the bar and countdown counts 1-12 and '+' one line further out.
// Below the bar a leading newline is trimmed unless a zero-width space comes first (Pine manual, plotshape() text),
// so the countdown texts below the bar start with an invisible U+200B character.
buySetupMark = showSetup and buySetup >= setupFrom and buySetup < 9 ? buySetup : 0
sellSetupMark = showSetup and sellSetup >= setupFrom and sellSetup < 9 ? sellSetup : 0
// Countdown number drawn on this bar: 1-12, 14 for '+', 0 for none (13 and a 1 next to a 9 are labels).
buyCountdownMark = showCountdown and buyCountdownBar and not buyCountdownDone and not buyNineShown ? (buyCountdownDeferred ? 14 : buyCountdown) : 0
sellCountdownMark = showCountdown and sellCountdownBar and not sellCountdownDone and not sellNineShown ? (sellCountdownDeferred ? 14 : sellCountdown) : 0

plotshape(buySetupMark == 1, 'Buy setup 1', location=location.belowbar, color=na, text='1', textcolor=buySetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 2, 'Buy setup 2', location=location.belowbar, color=na, text='2', textcolor=buySetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 3, 'Buy setup 3', location=location.belowbar, color=na, text='3', textcolor=buySetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 4, 'Buy setup 4', location=location.belowbar, color=na, text='4', textcolor=buySetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 5, 'Buy setup 5', location=location.belowbar, color=na, text='5', textcolor=buySetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 6, 'Buy setup 6', location=location.belowbar, color=na, text='6', textcolor=buySetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 7, 'Buy setup 7', location=location.belowbar, color=na, text='7', textcolor=buySetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buySetupMark == 8, 'Buy setup 8', location=location.belowbar, color=na, text='8', textcolor=buySetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 1, 'Sell setup 1', location=location.abovebar, color=na, text='1', textcolor=sellSetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 2, 'Sell setup 2', location=location.abovebar, color=na, text='2', textcolor=sellSetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 3, 'Sell setup 3', location=location.abovebar, color=na, text='3', textcolor=sellSetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 4, 'Sell setup 4', location=location.abovebar, color=na, text='4', textcolor=sellSetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 5, 'Sell setup 5', location=location.abovebar, color=na, text='5', textcolor=sellSetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 6, 'Sell setup 6', location=location.abovebar, color=na, text='6', textcolor=sellSetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 7, 'Sell setup 7', location=location.abovebar, color=na, text='7', textcolor=sellSetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellSetupMark == 8, 'Sell setup 8', location=location.abovebar, color=na, text='8', textcolor=sellSetupColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 1, 'Buy countdown 1', location=location.belowbar, color=na, text='​\n1', textcolor=buyCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 2, 'Buy countdown 2', location=location.belowbar, color=na, text='​\n2', textcolor=buyCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 3, 'Buy countdown 3', location=location.belowbar, color=na, text='​\n3', textcolor=buyCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 4, 'Buy countdown 4', location=location.belowbar, color=na, text='​\n4', textcolor=buyCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 5, 'Buy countdown 5', location=location.belowbar, color=na, text='​\n5', textcolor=buyCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 6, 'Buy countdown 6', location=location.belowbar, color=na, text='​\n6', textcolor=buyCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 7, 'Buy countdown 7', location=location.belowbar, color=na, text='​\n7', textcolor=buyCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 8, 'Buy countdown 8', location=location.belowbar, color=na, text='​\n8', textcolor=buyCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 9, 'Buy countdown 9', location=location.belowbar, color=na, text='​\n9', textcolor=buyCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 10, 'Buy countdown 10', location=location.belowbar, color=na, text='​\n10', textcolor=buyCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 11, 'Buy countdown 11', location=location.belowbar, color=na, text='​\n11', textcolor=buyCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 12, 'Buy countdown 12', location=location.belowbar, color=na, text='​\n12', textcolor=buyCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(buyCountdownMark == 14, 'Buy countdown +', location=location.belowbar, color=na, text='​\n+', textcolor=buyCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 1, 'Sell countdown 1', location=location.abovebar, color=na, text='1\n', textcolor=sellCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 2, 'Sell countdown 2', location=location.abovebar, color=na, text='2\n', textcolor=sellCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 3, 'Sell countdown 3', location=location.abovebar, color=na, text='3\n', textcolor=sellCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 4, 'Sell countdown 4', location=location.abovebar, color=na, text='4\n', textcolor=sellCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 5, 'Sell countdown 5', location=location.abovebar, color=na, text='5\n', textcolor=sellCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 6, 'Sell countdown 6', location=location.abovebar, color=na, text='6\n', textcolor=sellCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 7, 'Sell countdown 7', location=location.abovebar, color=na, text='7\n', textcolor=sellCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 8, 'Sell countdown 8', location=location.abovebar, color=na, text='8\n', textcolor=sellCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 9, 'Sell countdown 9', location=location.abovebar, color=na, text='9\n', textcolor=sellCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 10, 'Sell countdown 10', location=location.abovebar, color=na, text='10\n', textcolor=sellCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 11, 'Sell countdown 11', location=location.abovebar, color=na, text='11\n', textcolor=sellCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 12, 'Sell countdown 12', location=location.abovebar, color=na, text='12\n', textcolor=sellCountdownColor, size=size.tiny, editable=false, display=display.pane)
plotshape(sellCountdownMark == 14, 'Sell countdown +', location=location.abovebar, color=na, text='+\n', textcolor=sellCountdownColor, size=size.tiny, editable=false, display=display.pane)

// ---- Data window and alerts
plot(buySetup > 0 ? buySetup : na, 'Buy setup count', buySetupColor, display=display.data_window, precision=0)
plot(sellSetup > 0 ? sellSetup : na, 'Sell setup count', sellSetupColor, display=display.data_window, precision=0)
plot(buyCountdownActive or buyCountdownDone ? buyCountdown : na, 'Buy countdown count', buyCountdownColor, display=display.data_window, precision=0)
plot(sellCountdownActive or sellCountdownDone ? sellCountdown : na, 'Sell countdown count', sellCountdownColor, display=display.data_window, precision=0)

alertcondition(buySetupDone, 'Buy setup 9', 'TD Sequential: buy setup 9 on {{ticker}} ({{interval}})')
alertcondition(sellSetupDone, 'Sell setup 9', 'TD Sequential: sell setup 9 on {{ticker}} ({{interval}})')
alertcondition(buyCountdownDone, 'Buy countdown 13', 'TD Sequential: buy countdown 13 on {{ticker}} ({{interval}})')
alertcondition(sellCountdownDone, 'Sell countdown 13', 'TD Sequential: sell countdown 13 on {{ticker}} ({{interval}})')
